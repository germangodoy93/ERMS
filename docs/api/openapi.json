{
  "openapi": "3.1.0",
  "info": {
    "title": "ERMS API",
    "summary": "ERMS – Electronic Repair Management System",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: el proceso está en ejecución",
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: dependencias disponibles y esquema migrado",
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Un componente crítico no está disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "database"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "critical": {
            "type": "boolean",
            "title": "Critical",
            "description": "If true, an error makes the service not ready."
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "examples": [
              "revision 0001_initial (head)"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "critical"
        ],
        "title": "ComponentHealth"
      },
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error",
          "not_configured"
        ],
        "title": "ComponentStatus"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OverallStatus",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "LivenessResponse"
      },
      "OverallStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "OverallStatus"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OverallStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment",
          "checked_at",
          "components"
        ],
        "title": "ReadinessResponse"
      }
    }
  }
}
