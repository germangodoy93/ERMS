# Backend settings when running WITHOUT Docker (uv run ...). Copy to backend/.env.
# All settings: app/core/config.py

ENVIRONMENT=development
DATABASE_URL=postgresql://erms:CHANGE_ME@localhost:5432/erms
# Disposable database used by integration tests (it is wiped and re-migrated).
ERMS_TEST_DATABASE_URL=postgresql://erms:CHANGE_ME@localhost:5432/erms_test
# Optional until Celery is introduced.
REDIS_URL=
# Only needed if the SPA is served from a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_JSON=false
