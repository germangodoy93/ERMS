# Backend settings when running WITHOUT Docker (uv run ...). Copy to backend/.env.
# All settings: app/core/config.py

ENVIRONMENT=development
DATABASE_URL=postgresql://erms:CHANGE_ME@localhost:5432/erms
# Disposable database used by integration tests (it is wiped and re-migrated).
ERMS_TEST_DATABASE_URL=postgresql://erms:CHANGE_ME@localhost:5432/erms_test
# Optional until Celery is introduced.
REDIS_URL=
# Only needed if the SPA is served from a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_JSON=false

# --- Authentication -------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Defaults: 15-minute access token, 12-hour session, 2-hour idle timeout,
# lockout of 15 minutes after 5 failed attempts.
# ACCESS_TOKEN_TTL_MINUTES=15
# SESSION_MAX_HOURS=12
# SESSION_IDLE_MINUTES=120

# --- Photos (ADR-053) -------------------------------------------------------------
# Leave the S3_* variables empty to keep photos on local disk (demo mode). They go together.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ADDRESSING_STYLE=virtual

# --- Email (password recovery) ----------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Leave SMTP_HOST empty to disable sending (the attempt is logged without the link).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=ERMS <no-reply@example.com>
